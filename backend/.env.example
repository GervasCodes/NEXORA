# NEXORA backend environment variables.
#
# Copy this file to backend/.env and fill in real values:
#   cp .env.example .env
#
# Kept in sync with backend/src/config/envCheck.js's KNOWN_VARS list -
# every var the app reads anywhere in src/, database/seed.js, or
# server.js is listed below, grouped by concern. envCheck.js runs a
# warn-only check at boot for typos and missing required vars; it never
# blocks startup.

# ── Server ───────────────────────────────────────────────────────────
# Port the Express server listens on. Optional, defaults to 3000 if unset.
PORT=3000
# "development", "test", or "production". Several vars below (mobile
# money provider, ClamAV) become hard-required only when this is
# "production" - see envCheck.js.
NODE_ENV=development
# Comma-separated allowlist of frontend origin(s) allowed to call the
# API and connect via Socket.IO, e.g. https://app.example.com. Falls
# back to "*" (allow any origin) if unset - fine for local dev only,
# must be set explicitly in production. This must be the exact origin
# the browser's address bar shows (scheme + host, no path) - e.g.
# https://nexoramarketplace.online, not an onrender.com URL, and not
# both a www and non-www variant unless both are actually served.
CORS_ORIGIN=
# pino log level: "fatal" | "error" | "warn" | "info" | "debug" |
# "trace" | "silent". Optional, defaults to "info".
LOG_LEVEL=info
# Number of reverse-proxy hops in front of this app, for Express's
# "trust proxy" setting (see the comment in src/app.js) - controls how
# the real client IP is extracted from X-Forwarded-For, which feeds
# express-rate-limit and the webhook IP-allowlist check in
# webhookAuth.middleware.js. Optional, defaults to 1 (Render's own
# proxy only). Only raise this to 2 once this API's own domain is
# confirmed actually proxied through Cloudflare (orange-cloud DNS,
# end-to-end, including whatever hostname payment-provider webhooks are
# configured to call) - raising it before that is live under-trusts
# real traffic, but raising it correctly is what keeps the webhook IP
# allowlist and rate limiter accurate once Cloudflare is in front.
TRUST_PROXY_HOPS=1

# ── Database (primary, required) ────────────────────────────────────
# MySQL 8+ (or MariaDB 10.6+) connection. All five required - the app
# won't run without them (enforced by envCheck.js's REQUIRED_ALWAYS).
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=nexora
# Optional TLS for the primary connection - needed for most managed
# MySQL providers (Aiven, PlanetScale, RDS, DigitalOcean managed DB).
# DB_SSL=true encrypts the connection; DB_SSL_REJECT_UNAUTHORIZED=false
# skips validating the server's cert chain (still encrypted, just not
# verified) - set to true only once DB_SSL_CA/DB_SSL_CA_PATH is set.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Inline CA cert contents (use \n for newlines) - takes precedence over
# DB_SSL_CA_PATH if both are set.
DB_SSL_CA=
# Path to a CA cert file on disk - strongest option if your provider
# gives you one.
DB_SSL_CA_PATH=

# ── Database (read replica, optional) ───────────────────────────────
# Opt-in read-replica pool (see backend/src/config/dbRead.js). Leaving
# DB_READ_HOST unset makes every "read" query use the primary pool
# instead - a complete no-op, not a partial/broken state. See
# docs/SCALABILITY_REPORT.md for the rollout plan.
DB_READ_HOST=
DB_READ_PORT=
DB_READ_USER=
DB_READ_PASSWORD=
DB_READ_NAME=
DB_READ_SSL=false
DB_READ_SSL_REJECT_UNAUTHORIZED=true
DB_READ_SSL_CA=
DB_READ_SSL_CA_PATH=
# Connection pool size for the read pool. Optional, defaults to 10.
DB_READ_CONNECTION_LIMIT=10
# Optional tuning (defaults in src/config/db.js): connect timeout, size of the pool used for
# row-locking transactions, lock wait, per-statement execution cap and the pool's queue length.
DB_CONNECT_TIMEOUT_MS=
DB_LOCK_POOL_LIMIT=
DB_LOCK_WAIT_TIMEOUT_S=
DB_MAX_EXECUTION_MS=
DB_POOL_QUEUE_LIMIT=

# ── Scheduled jobs ───────────────────────────────────────────────────
# "true" (default) runs every scheduled job (escrow release, booking
# lifecycle, sponsorship expiry, monetization schedule, etc.) in the
# same process as the HTTP server - fine for a single-instance
# deployment. Set to "false" on each web instance once you're running
# `npm run worker` as a separate process/service, so jobs don't run
# once per web instance. See docs/DEPLOYMENT.md §3.1.
RUN_JOBS_IN_PROCESS=true

# ── Auth (required) ──────────────────────────────────────────────────
# Secret used to sign/verify JWTs. Required - the app won't run
# without it. Rotating this value invalidates every existing session
# (all issued JWTs fail signature verification) - use a long, random
# value and treat it like any other production secret.
JWT_SECRET=

# ── Google sign-in (optional) ────────────────────────────────────────
# OAuth 2.0 Web client ID from Google Cloud Console (APIs & Services >
# Credentials). The backend verifies every Google ID token against it
# (POST /auth/google). Leave empty to disable: the endpoint then answers
# "Google sign-in is not available". Use the SAME value as the frontend's
# VITE_GOOGLE_CLIENT_ID. Add your frontend origin(s) under "Authorized
# JavaScript origins" in Google Cloud Console.
GOOGLE_CLIENT_ID=

# ── Admin account seeding (optional, all three or none) ─────────────
# If all three are set, `database/seed.js` creates a single initial
# admin account on a brand-new database (safe to re-run - skips if one
# already exists). Setting only some of the three is flagged by
# envCheck.js as a likely mistake, since seed.js refuses to run until
# all three are present.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# ── Mobile money (Selcom / AzamPay via the mobileMoney router) ──────
# mobileMoney.provider.js is a router, not a placeholder - it dispatches
# to a real provider based on MOBILE_MONEY_PROVIDER. Required in
# production (enforced by envCheck.js); outside production, leaving it
# unset falls back to a no-network simulate provider.
MOBILE_MONEY_PROVIDER=
MOBILE_MONEY_API_BASE_URL=
MOBILE_MONEY_API_KEY=
MOBILE_MONEY_API_SECRET=
MOBILE_MONEY_VENDOR_ID=
# Shared-secret used to authenticate incoming Selcom webhooks
# (webhookAuth.middleware.js) - fails closed in production if unset.
SELCOM_WEBHOOK_SECRET=
# Selcom: dedicated names win over the generic MOBILE_MONEY_* values above.
SELCOM_API_BASE_URL=
SELCOM_API_KEY=
SELCOM_API_SECRET=
SELCOM_VENDOR_ID=
# Public base URL of this API, sent to Selcom as the webhook address.
SELCOM_PUBLIC_API_URL=
# Card methods offered on Selcom's hosted page (default ALL).
SELCOM_CARD_PAYMENT_METHODS=
AZAMPAY_API_BASE_URL=
# Falls back to AZAMPAY_API_BASE_URL when the auth host is the same.
AZAMPAY_AUTH_BASE_URL=
AZAMPAY_APP_NAME=
AZAMPAY_CLIENT_ID=
AZAMPAY_CLIENT_SECRET=
AZAMPAY_API_KEY=
AZAMPAY_VENDOR_ID=
AZAMPAY_VENDOR_NAME=NEXORA
# Shared secret authenticating incoming AzamPay webhooks (fails closed in production if unset).
AZAMPAY_WEBHOOK_SECRET=

# ── PayPal (opt-in, disabled by default in the registry) ────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" or "live".
PAYPAL_MODE=sandbox

# ── Cloudinary (required - product/store image uploads) ─────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Brevo (transactional email - OTP login, notifications) ──────────
# Sent over Brevo's HTTPS API, not SMTP. Optional outside production -
# the app logs and continues instead of sending if unset.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=NEXORA
# Optional override for the logo image embedded in every outgoing email
# (emailTemplate.js#renderEmail). Defaults to <APP_URL>/nexora-logo.png
# (the file Vite copies from frontend/public/ to the deployed site's
# root) - only set this if the logo is served somewhere else, e.g. a CDN.
EMAIL_LOGO_URL=
# Custom header value configured on Brevo's webhook settings for
# delivery-status callbacks (Phase 5, production error fixes) - see
# webhookAuth.middleware.js#verifySharedSecretHeader and
# modules/broadcast/brevoWebhook.controller.js. Optional outside
# production, same fail-open-in-dev/fail-closed-in-prod behavior as
# the other *_WEBHOOK_SECRET vars below.
BREVO_WEBHOOK_SECRET=

# ── Web push (VAPID keys) ────────────────────────────────────────────
# Optional - push notifications are skipped if unset.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Routing (delivery ETA / distance) ───────────────────────────────
# All optional with sane defaults - the app runs unmodified with none
# of these set (OSRM's free public demo server, straight-line
# fallback). See docs/ROUTING.md.
OSRM_BASE_URL=
OSRM_PROFILE=
OSRM_TIMEOUT_MS=
# "osrm" (default) or "fallback" (forces straight-line estimates only).
ROUTING_PROVIDER=osrm
ROUTING_FALLBACK_ENABLED=true

# ── Sentry (error tracking) ─────────────────────────────────────────
# Optional - Sentry.init() is skipped entirely when SENTRY_DSN is
# unset, so local dev/CI never need a real DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Set to your deployed commit SHA in CI/CD to group errors by release.
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# ── Redis (RF5 caching layer - category/product listing cache; also
#    Phase 1's durable dispatch offer-expiry queue - see
#    queues/dispatchQueue.js) ──────────────────────────────────────────
# Optional for caching (omitting REDIS_URL just means the app runs
# uncached, no code path changes) but effectively required for durable
# delivery-dispatch offer expiry: without it, offer timeouts fall back
# to a non-durable in-process timer that's lost on restart (fine for
# local dev/CI, not for a real deployment). Aiven-style single-URI
# credential (rediss://user:pass@host:port), matching how most managed
# Redis providers hand you the connection string.
REDIS_URL=
# Explicit off-switch, distinct from "REDIS_URL not set" - lets an
# environment that already has REDIS_URL configured still opt out.
REDIS_DISABLED=false
REDIS_TLS_REJECT_UNAUTHORIZED=true
# Cache TTL in seconds. Optional, defaults to 45.
CACHE_TTL_SECONDS=45

# ── WhatsApp Cloud API ───────────────────────────────────────────────
# All optional - omitting these falls back to a no-network simulate
# provider outside production, same shape as MOBILE_MONEY_PROVIDER.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ── SMS gateway (Roadmap Phase 1: offer-accept fallback) ────────────
# All optional - omitting SMS_GATEWAY_API_KEY/SECRET_KEY falls back to
# a no-network simulate provider outside production, same shape as the
# WhatsApp block above. Used as the offer-accept-by-reply fallback for
# delivery agents when WhatsApp isn't configured.
SMS_GATEWAY_BASE_URL=
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SECRET_KEY=
SMS_GATEWAY_SENDER_ID=
SMS_GATEWAY_WEBHOOK_SECRET=

# ── Frontend URL (used in outbound links, e.g. WhatsApp messages) ───
# The frontend's own public origin, e.g. https://nexoramarketplace.online
# - no path, no trailing slash. Keep this and CORS_ORIGIN pointed at the
# same hostname the browser actually shows; if that hostname is proxied
# through Cloudflare, this still just needs the public domain, not the
# Cloudflare or Render internal address.
FRONTEND_URL=

# ── Render deploy hook (Round 6 Phase 2 - dynamic SEO shells) ──
# Optional. The frontend static site's Render deploy hook URL (that
# service's Settings tab -> Deploy Hook) - renderDeployHook.job.js POSTs
# to it every 6 hours so frontend/scripts/prerender-shells.mjs re-runs
# against fresh product/service/store data. Leave empty to disable;
# dynamic shells then only refresh on a real deploy.
RENDER_DEPLOY_HOOK_URL=

# ── TRA VFD (Tanzania e-invoicing) ──────────────────────────────────
# Optional - falls back to a simulate provider outside production,
# same shape as the payment providers above.
TRA_VFD_BASE_URL=
TRA_VFD_API_KEY=

# ── ClamAV (upload malware scanning via clamd) ──────────────────────
# Optional in every environment, production included - omitting
# CLAMAV_HOST just skips scanning with a warning and lets uploads
# through unscanned. Set it to actually turn scanning on; once set,
# infected files are rejected.
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Connection pool tuning (RF4) ─────────────────────────────────────
# mysql2 pool size for the primary connection. Optional, defaults to
# 10. Raise this only in response to a real "db-pool" enqueue warning
# in your logs/Sentry, not preemptively - and note your DB provider's
# total-connection ceiling applies across your whole account, so this
# multiplies per instance on a multi-instance deployment. See
# docs/DEPLOYMENT.md's Observability section.
DB_POOL_CONNECTION_LIMIT=10

# ══ Added so that every variable the code reads is documented ═══════
# (Compare with: grep -rhoE "process\.env\.[A-Z0-9_]+" src server.js worker.js)

# ── Startup safety checks (config/envCheck.js) ───────────────────────
# NODE_ENV must be exactly production, development or test. Anything other than "production" makes the
# payment, SMS, WhatsApp and TRA integrations use their SIMULATE providers, so a mistyped value is
# refused at startup, as is a non-production process pointed at a non-local database.
# Set this to true ONLY for a deliberate shared staging database (never for production):
# ALLOW_NON_LOCAL_DEV_DB=true
# When true, production security warnings (unverified database TLS, missing CORS_ORIGIN, short
# JWT_SECRET, open Selcom webhook, missing PHONE_ENCRYPTION_KEY, test-only switches set) stop startup
# instead of only being logged. Turn on once the warnings in your logs are clear.
# In production, unverified DB TLS, missing CORS_ORIGIN and an open Selcom webhook ALWAYS block startup.
# true = also block on the remaining security findings; false = skip the mandatory checks (logged opt-out).
STRICT_SECURITY_CHECKS=
# Admin session lifetime (default 8h; other roles keep 7d).
ADMIN_SESSION_TTL=
# Payouts at or above this amount (TZS) need approval from two different admins. Default 1000000.
# 0 turns the rule off; smaller payouts and rejections always need one admin.
PAYOUT_DUAL_APPROVAL_THRESHOLD=

# ── Dedicated key for stored payer phone numbers (utils/phoneEncryption.js) ──
# Without it the key is derived from JWT_SECRET (so rotating the session secret would make stored
# numbers unreadable). Generate once, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Existing values keep working; convert them with: node scripts/reencryptPhones.js --apply
PHONE_ENCRYPTION_KEY=
# Label stored with each new value (change when you rotate) and the key being rotated away from.
PHONE_ENCRYPTION_KEY_ID=k1
PHONE_ENCRYPTION_KEY_PREVIOUS=

# ── Payments: provider switches and tuning ───────────────────────────
PAYMENT_ENABLE_PAYPAL=
PAYPAL_WEBHOOK_ID=
# Which card gateway handles card payments (see modules/payment/providers/card.provider.js).
CARD_PROVIDER=
# Allowed difference between the amount charged and the order total, in percent (rounding, FX).
PAYMENT_AMOUNT_TOLERANCE_PERCENT=
# Pause new payments with a notice (true/false); listed user ids can still test. See paymentsMaintenance.middleware.js.
PAYMENTS_MAINTENANCE=
PAYMENTS_MAINTENANCE_MESSAGE=
PAYMENTS_MAINTENANCE_TESTER_IDS=
# How many days back the nightly reconciliation looks.
PAYMENT_RECONCILIATION_DAYS=
# Minutes after which an unpaid order/booking/payment is considered stale (jobs/staleOrders, bookingExpiry).
STALE_PAYMENT_MINUTES=
STALE_PAYMENT_HARD_MINUTES=
STALE_HOSTED_PAYMENT_MINUTES=
STALE_HOSTED_PAYMENT_HARD_MINUTES=
STALE_BOOKING_MINUTES=

# ── pawaPay (mobile money, modules/payment/providers/pawapay.provider.js) ──
PAWAPAY_API_TOKEN=
PAWAPAY_API_BASE_URL=
PAWAPAY_MODE=
# Host used to verify callback signatures, if it differs from the request host.
PAWAPAY_CALLBACK_AUTHORITY=
# TEST ONLY. Never set in production (STRICT_SECURITY_CHECKS reports it).
# PAWAPAY_ALLOW_UNSIGNED_CALLBACKS=true

# ── WhatsApp message templates ───────────────────────────────────────
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_ORDER_TEMPLATE_LANG=
WHATSAPP_OTP_TEMPLATE_NAME=
WHATSAPP_OTP_TEMPLATE_LANG=

# ── AI features (modules/ai). Needs ai_enabled turned on in admin settings. ──
# Pick ONE provider (anthropic | openai | gemini | groq | openrouter) and set only its key.
AI_PROVIDER=
AI_MODEL=
# Only for an OpenAI-compatible endpoint other than the default.
AI_PROVIDER_BASE_URL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional OpenRouter attribution headers.
AI_OPENROUTER_SITE_URL=
AI_OPENROUTER_SITE_NAME=

# ── Misc ─────────────────────────────────────────────────────────────
# Lifetime (seconds) of signed links to private verification documents.
DOCUMENT_URL_TTL_SECONDS=
# Shown in emails and legal pages as the support address, and used as the reply-to address.
SUPPORT_EMAIL=
# Legacy fallback: used as the sender/reply-to address only when BREVO_SENDER_EMAIL / SUPPORT_EMAIL are
# unset. Prefer setting those two. (The old SMTP variables EMAIL_HOST/PORT/USER/PASSWORD were removed
# from this file: no code reads them.)
EMAIL_FROM=

# ══ Local testing ONLY - never set any of these on a real server ═════
# Lets the Selcom/AzamPay webhooks pass without a signature (ignored when NODE_ENV=production).
# ALLOW_UNSIGNED_WEBHOOKS=true
# Allows the platform data-reset tool; the second one lets it touch real tables.
# ALLOW_PLATFORM_DATA_RESET=true
# ALLOW_PLATFORM_DATA_RESET_REAL=true
# Token that lets the load-test tool bypass rate limits.
# LOADTEST_BYPASS_TOKEN=

# ── Database tooling (database/setup-test-db.js, for the local test database only) ──
# ROOT_USER=root
# ROOT_PASSWORD=
# DB_SOCKET=/run/mysqld/mysqld.sock
