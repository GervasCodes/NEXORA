{
  "name": "nexora-database",
  "version": "1.0.0",
  "private": true,
  "description": "Migration and seed scripts for the NEXORA database. Run `npm install` in this folder once, then use the scripts below.",
  "scripts": {
    "migrate": "node migrate.js",
    "migrate:status": "node migrate.js --status",
    "seed": "node seed.js",
    "setup:test-db": "node setup-test-db.js",
    "backup": "node backup.js",
    "restore": "node restore.js",
    "check:docs-drift": "node checkMigrationDocsDrift.js",
    "docs:schema": "node generate-schema-docs.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.10",
    "mysql2": "^3.22.5"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
