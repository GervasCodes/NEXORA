# NEXORA frontend environment variables.
#
# Copy this file to frontend/.env and fill in real values:
#   cp .env.example .env
#
# All Vite env vars must be prefixed VITE_ to be exposed to client code
# (see https://vitejs.dev/guide/env-and-mode.html) - this is the
# complete list of ones NEXORA actually reads (src/api/client.js,
# src/context/SocketContext.jsx, src/main.jsx).

# Base URL of the backend API, including the /api/v1 prefix.
# Optional - defaults to http://localhost:5000/api/v1 (a local backend
# on its default port) if unset.
VITE_API_URL=http://localhost:5000/api/v1

# Socket.IO server URL. Optional - if unset, falls back to VITE_API_URL
# with the /api/v1 suffix stripped (i.e. the same host as the API).
# Only set this separately if your Socket.IO server is deployed on a
# different host/port from the REST API.
VITE_SOCKET_URL=

# Sentry error tracking (frontend). Optional - Sentry.init() is skipped
# entirely when this is unset, so local dev/CI never need a real DSN.
VITE_SENTRY_DSN=
# Optional - falls back to Vite's own MODE ("development"/"production")
# if unset.
VITE_SENTRY_ENVIRONMENT=

# Google sign-in (optional). Same OAuth Web client ID as the backend's
# GOOGLE_CLIENT_ID. Leave empty and the "Sign in with Google" button is simply
# not shown.
VITE_GOOGLE_CLIENT_ID=

# Google Analytics 4 measurement id ("G-XXXXXXXXXX"). Optional. When set, the
# cookie banner asks visitors to Accept/Decline analytics and GA loads ONLY
# after Accept. Leave empty to ship with no analytics at all. Remember the
# CSP (see docs/DEPLOYMENT.md) must allow Google's analytics hosts.
VITE_GA_MEASUREMENT_ID=

# Optional Search Console meta-tag verification token (a backup to the HTML
# file already in /public).
VITE_GSC_VERIFICATION=

# Public contact details shown on the Contact page and in its structured data.
# Optional - the built-in defaults are the details already published on /legal/company-information.
# Use a company-domain mailbox here when you have one.
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_REGISTERED_ADDRESS=
