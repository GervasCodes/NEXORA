# (Security Hardening). Netlify reads this file to attach
# response headers by path (see the existing public/_redirects, which
# confirms Netlify is the actual deploy target for this frontend) - see
# https://docs.netlify.com/routing/headers/ for the exact matching
# rules this depends on.
#
# There was no Content-Security-Policy at all before this - anything
# that ever ends up rendered as HTML on this origin (a reflected value,
# a future bug) had no browser-side backstop. This is scoped to what the
# app actually loads today:
#   - script-src 'self' only - index.html has no inline <script>, just
#     Vite's own bundled module script, so this is a real restriction,
#     not a formality.
#   - style-src allows Google Fonts' stylesheet host (index.html's
#     <link rel="stylesheet" href="https://fonts.googleapis.com/...">)
#     plus 'unsafe-inline', which React's `style={{...}}` prop and
#     several UI libraries (Leaflet map tiles/markers, react-leaflet)
#     rely on - locking this down further would need an app-wide
#     nonce/hash pipeline this build doesn't have yet (see "Not covered
#     by this file" below).
#   - font-src covers Google Fonts' font-file host.
#   - img-src covers Cloudinary (product/store photo delivery - see
#     backend/src/config/cloudinary.js) and OpenStreetMap's tile hosts
#     (AdminDispatchMap.jsx/LocationPicker.jsx/DeliveryTrackingMap.jsx).
#   - connect-src MUST include your actual deployed backend API and
#     Socket.IO origins - see "REQUIRED MANUAL STEP" below. Left as
#     'self' only for now, which will break the app in production if a
#     cross-origin backend is used - this file can't see your build's
#     VITE_API_URL/VITE_SOCKET_URL, which are only known at build/deploy
#     time, not when this static file is written.
#
# NOTE: connect-src below allows api.nexoramarketplace.online and Render's *.onrender.com
# (both hosts referenced in this repo). Tighten to your single real API host once settled.
# (Original note) replace the two placeholder origins below with
# your actual deployed backend API and Socket.IO URLs (the same values
# you set for VITE_API_URL/VITE_SOCKET_URL - see frontend/.env.example)
# before relying on this in production. Until you do, the app will work
# in development (no CSP applies to `npm run dev`) but a cross-origin
# API/socket connection will be silently blocked once this header is
# live on Netlify.
# Phase 7 additions to the CSP below (each one is something the app already
# loads and was being blocked or relied on a missing directive):
#   img-src      images.unsplash.com (seed/demo imagery), unpkg.com (Leaflet
#                marker icons), blob: (client-side upload previews);
#   media-src    Cloudinary-hosted product video;
#   frame-src    only the live-selling embeds (YouTube, Facebook); the
#                backend and liveSellingEmbed.js refuse every other host;
#   connect-src  Nominatim (address search) and Sentry's ingest hosts;
#   form-action / worker-src / manifest-src / upgrade-insecure-requests.
# Phase 7 (round 5) - Google sign-in (Google Identity Services). Per Google's
# documented CSP: script-src https://accounts.google.com/gsi/client, frame-src
# and connect-src https://accounts.google.com/gsi/, style-src
# https://accounts.google.com/gsi/style. The ID token itself is verified by the
# backend (POST /auth/google), never trusted from the browser.
# Private verification documents open in a separate tab through a signed
# Cloudinary link, so they need no CSP entry. If you use a Sentry region
# other than the three listed, add its ingest host to connect-src.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://res.cloudinary.com https://images.unsplash.com https://unpkg.com https://*.tile.openstreetmap.org; media-src 'self' https://res.cloudinary.com; frame-src https://accounts.google.com/gsi/ https://www.youtube.com https://www.youtube-nocookie.com https://www.facebook.com; connect-src 'self' https://accounts.google.com/gsi/ https://api.nexoramarketplace.online wss://api.nexoramarketplace.online https://*.onrender.com wss://*.onrender.com https://nominatim.openstreetmap.org https://*.ingest.sentry.io https://*.ingest.de.sentry.io https://*.ingest.us.sentry.io; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

# offline.html (the PWA service-worker fallback page - see public/sw.js)
# has its own inline <style> block and isn't part of the React app - a
# more specific path match here overrides style-src for this one file
# only, per Netlify's header-matching precedence, rather than loosening
# the site-wide rule above.
/offline.html
  Content-Security-Policy: default-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'

# --- CDN cache policy (Phase 2: Reliability & performance groundwork) ---
# Netlify fronts this site with its own CDN already - these headers just
# tell it (and any browser/intermediate cache) how long each kind of file
# is safe to keep, rather than relying on Netlify's defaults for every
# path alike.
#
# Every JS/CSS file Vite emits under /assets/ is content-hashed in its
# filename (see vite.config.js's manualChunks + emptyOutDir comments -
# the hash changes whenever the content does), so a given URL's content
# can never change under the same name. That makes it safe to cache for
# the maximum practical duration and mark `immutable` (tells supporting
# browsers to skip revalidation entirely, not just rely on a long
# max-age): a new deploy ships new filenames, it never overwrites an old
# one in place.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The PWA icon/splash set and the static brand/image assets likewise
# never change content under the same filename in practice (a logo swap
# ships as a new file, not an in-place overwrite) - same caching logic
# as /assets/* above, kept as a separate rule since they live at the
# public root rather than under /assets/.
/favicon-16.png
  Cache-Control: public, max-age=31536000, immutable
/favicon-32.png
  Cache-Control: public, max-age=31536000, immutable
/icon-180.png
  Cache-Control: public, max-age=31536000, immutable
/icon-192.png
  Cache-Control: public, max-age=31536000, immutable
/icon-512.png
  Cache-Control: public, max-age=31536000, immutable
/icon-512-maskable.png
  Cache-Control: public, max-age=31536000, immutable
/nexora-logo.png
  Cache-Control: public, max-age=31536000, immutable
/og-banner.png
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=31536000, immutable

# The opposite end: index.html is the SPA shell every route rewrites to
# (see _redirects' /* -> /index.html 200) and its own filename never
# changes, so without an explicit rule it would inherit a CDN's default
# static-asset caching and visitors could keep loading a stale shell
# (pointing at deleted/renamed hashed /assets/ files from a prior
# deploy) until that cache expires. no-cache (not no-store) still lets
# the browser/CDN keep a copy, but forces revalidation on every request
# so a new deploy is picked up immediately.
/index.html
  Cache-Control: no-cache

# sw.js is the service worker itself (see public/sw.js's own
# CACHE_VERSION-bump convention) - browsers already special-case it to
# revalidate at most every 24h regardless of headers, but a long/default
# cache on an intermediate CDN layer could otherwise serve a stale
# worker to a fresh visitor for a full cache lifetime. no-cache forces
# revalidation on every fetch so a CACHE_VERSION bump rolls out as soon
# as the browser's own daily check allows, not after a separate CDN
# cache window.
/sw.js
  Cache-Control: no-cache

# manifest.json and robots.txt are small, rarely-changed, and need to
# reflect edits promptly (a robots.txt change restricting a crawler
# should take effect quickly, not after a long CDN TTL) - no-cache for
# the same "always revalidate" reasoning as above.
/manifest.json
  Cache-Control: no-cache
/robots.txt
  Cache-Control: no-cache
