diff --git a/frontend/tests/hooks/useInfiniteScroll.test.jsx b/frontend/tests/hooks/useInfiniteScroll.test.jsx
new file mode 100644
index 0000000..313e86e
--- /dev/null
+++ b/frontend/tests/hooks/useInfiniteScroll.test.jsx
@@ -0,0 +1,142 @@
+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import { render, act } from "@testing-library/react";
+
+let saverState = null;
+vi.mock("../../src/context/DataSaverContext", () => ({
+    useDataSaver: () => saverState
+}));
+
+import useInfiniteScroll from "../../src/hooks/useInfiniteScroll";
+
+// The shared test setup stubs IntersectionObserver with a no-op class. Here
+// we need to observe construction and trigger the callback by hand.
+let observers;
+class FakeObserver {
+    constructor(cb, options) {
+        this.cb = cb;
+        this.options = options;
+        this.observed = [];
+        this.disconnected = false;
+        observers.push(this);
+    }
+    observe(el) { this.observed.push(el); }
+    unobserve() {}
+    disconnect() { this.disconnected = true; }
+    trigger(isIntersecting = true) { this.cb([{ isIntersecting }]); }
+}
+
+function Harness({ showSentinel = true, onResult, ...opts }) {
+    const result = useInfiniteScroll(opts);
+    onResult?.(result);
+    return showSentinel ? <div data-testid="sentinel" ref={result.sentinelRef} /> : null;
+}
+
+const live = () => observers.filter((o) => !o.disconnected);
+
+describe("useInfiniteScroll", () => {
+    let original;
+    beforeEach(() => {
+        original = global.IntersectionObserver;
+        observers = [];
+        saverState = null;
+        global.IntersectionObserver = FakeObserver;
+    });
+    afterEach(() => { global.IntersectionObserver = original; });
+
+    it("observes the sentinel and loads more when it intersects", () => {
+        const onLoadMore = vi.fn();
+        const { getByTestId } = render(<Harness hasMore loading={false} onLoadMore={onLoadMore} />);
+        expect(live()).toHaveLength(1);
+        expect(live()[0].observed[0]).toBe(getByTestId("sentinel"));
+        act(() => live()[0].trigger(true));
+        expect(onLoadMore).toHaveBeenCalledTimes(1);
+    });
+
+    it("ignores non-intersecting entries", () => {
+        const onLoadMore = vi.fn();
+        render(<Harness hasMore loading={false} onLoadMore={onLoadMore} />);
+        act(() => live()[0].trigger(false));
+        expect(onLoadMore).not.toHaveBeenCalled();
+    });
+
+    it("uses a 400px rootMargin by default and accepts an override", () => {
+        render(<Harness hasMore loading={false} onLoadMore={() => {}} />);
+        expect(live()[0].options.rootMargin).toBe("400px");
+        observers = [];
+        render(<Harness hasMore loading={false} onLoadMore={() => {}} rootMargin="50px" />);
+        expect(live()[0].options.rootMargin).toBe("50px");
+    });
+
+    it.each([
+        ["there is nothing more to load", { hasMore: false }],
+        ["a page is already loading", { loading: true }],
+        ["an error is set", { error: new Error("boom") }],
+        ["it is explicitly disabled", { disabled: true }]
+    ])("does not observe when %s", (_label, override) => {
+        let result;
+        render(<Harness hasMore loading={false} onLoadMore={() => {}} {...override} onResult={(r) => { result = r; }} />);
+        expect(live()).toHaveLength(0);
+        expect(result.autoLoad).toBe(false);
+    });
+
+    it("turns auto-load off in data-saver mode", () => {
+        saverState = { enabled: true };
+        let result;
+        render(<Harness hasMore loading={false} onLoadMore={() => {}} onResult={(r) => { result = r; }} />);
+        expect(live()).toHaveLength(0);
+        expect(result.autoLoad).toBe(false);
+    });
+
+    it("works without a DataSaverProvider (context is null)", () => {
+        saverState = null;
+        let result;
+        render(<Harness hasMore loading={false} onLoadMore={() => {}} onResult={(r) => { result = r; }} />);
+        expect(result.autoLoad).toBe(true);
+    });
+
+    it("calls the latest onLoadMore without re-creating the observer", () => {
+        const first = vi.fn();
+        const second = vi.fn();
+        const { rerender } = render(<Harness hasMore loading={false} onLoadMore={first} />);
+        const before = observers.length;
+        rerender(<Harness hasMore loading={false} onLoadMore={second} />);
+        expect(observers).toHaveLength(before);
+        act(() => live()[0].trigger(true));
+        expect(first).not.toHaveBeenCalled();
+        expect(second).toHaveBeenCalledTimes(1);
+    });
+
+    it("disconnects when loading starts and re-attaches when it ends", () => {
+        const { rerender } = render(<Harness hasMore loading={false} onLoadMore={() => {}} />);
+        const first = live()[0];
+        rerender(<Harness hasMore loading onLoadMore={() => {}} />);
+        expect(first.disconnected).toBe(true);
+        expect(live()).toHaveLength(0);
+        rerender(<Harness hasMore loading={false} onLoadMore={() => {}} />);
+        expect(live()).toHaveLength(1);
+    });
+
+    it("re-attaches to a new sentinel node after the list is remounted", () => {
+        const { rerender, getByTestId } = render(<Harness hasMore loading={false} onLoadMore={() => {}} />);
+        const firstNode = getByTestId("sentinel");
+        rerender(<Harness hasMore loading={false} onLoadMore={() => {}} showSentinel={false} />);
+        expect(live()).toHaveLength(0);
+        rerender(<Harness hasMore loading={false} onLoadMore={() => {}} />);
+        const secondNode = getByTestId("sentinel");
+        expect(secondNode).not.toBe(firstNode);
+        expect(live()).toHaveLength(1);
+        expect(live()[0].observed[0]).toBe(secondNode);
+    });
+
+    it("disconnects on unmount", () => {
+        const { unmount } = render(<Harness hasMore loading={false} onLoadMore={() => {}} />);
+        const obs = live()[0];
+        unmount();
+        expect(obs.disconnected).toBe(true);
+    });
+
+    it("does not throw when IntersectionObserver is unavailable", () => {
+        delete global.IntersectionObserver;
+        expect(() => render(<Harness hasMore loading={false} onLoadMore={() => {}} />)).not.toThrow();
+    });
+});
diff --git a/frontend/tests/pages/RegisterUploadProgress.test.jsx b/frontend/tests/pages/RegisterUploadProgress.test.jsx
new file mode 100644
index 0000000..d477e8f
--- /dev/null
+++ b/frontend/tests/pages/RegisterUploadProgress.test.jsx
@@ -0,0 +1,90 @@
+import { describe, it, expect, vi, beforeEach } from "vitest";
+import { render, screen, act, waitFor, fireEvent } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { MemoryRouter } from "react-router-dom";
+
+const mockRegister = vi.fn();
+vi.mock("../../src/context/AuthContext", () => ({
+    useAuth: () => ({ register: mockRegister })
+}));
+vi.mock("../../src/context/LanguageContext", () => ({
+    useLanguage: () => ({ t: (key) => key })
+}));
+vi.mock("../../src/api/client", () => ({
+    default: { get: vi.fn(() => Promise.resolve({ data: { data: { available: true } } })) }
+}));
+
+import Register from "../../src/pages/Register";
+
+const byLabel = (key) => screen.getByLabelText(new RegExp(`^${key}`));
+
+const fillAccountAndContinue = async (user) => {
+    await user.selectOptions(screen.getByLabelText(/auth\.roleLabel/), "seller");
+    await user.type(byLabel("auth.firstNameLabel"), "Amina");
+    await user.type(byLabel("auth.lastNameLabel"), "Mrisho");
+    await user.type(byLabel("username.label"), "amina_m");
+    await screen.findByText("username.available");
+    await user.type(byLabel("auth.emailLabel"), "amina@example.com");
+    await user.type(screen.getByPlaceholderText("712 345 678"), "712345678");
+    await user.type(byLabel("auth.passwordLabel"), "supersecret1");
+    await user.type(byLabel("auth.confirmPasswordLabel"), "supersecret1");
+    await user.click(screen.getByLabelText(/terms_accepted|auth\.termsPrefix/i, { selector: "input" }));
+    await user.click(screen.getByRole("button", { name: "auth.continueToVerification" }));
+};
+
+// jsdom's native `required` validation does not see files attached through
+// user.upload, so submit the form directly (the component's own checks still run).
+const submitDocuments = (container) => {
+    fireEvent.submit(container.querySelector('input[type="file"]').closest("form"));
+};
+
+const attachDocuments = async (user, container) => {
+    const [photo, idDoc] = container.querySelectorAll('input[type="file"]');
+    await user.upload(photo, new File(["p"], "me.jpg", { type: "image/jpeg" }));
+    await user.upload(idDoc, new File(["d"], "id.pdf", { type: "application/pdf" }));
+};
+
+describe("Register - document upload progress", () => {
+    beforeEach(() => { mockRegister.mockReset(); });
+
+    it("passes an onUploadProgress callback and shows a progress bar while documents upload", async () => {
+        let finish;
+        mockRegister.mockImplementation((_payload, options) => new Promise((resolve) => {
+            options.onUploadProgress({ loaded: 40, total: 100 });
+            finish = () => resolve({ success: true });
+        }));
+
+        const user = userEvent.setup();
+        const { container } = render(<MemoryRouter><Register /></MemoryRouter>);
+        await fillAccountAndContinue(user);
+        expect(screen.queryByRole("progressbar")).toBeNull();
+
+        await attachDocuments(user, container);
+        submitDocuments(container);
+
+        const bar = await screen.findByRole("progressbar", { name: "upload.progress" });
+        expect(bar).toHaveAttribute("aria-valuenow", "40");
+        expect(mockRegister.mock.calls[0][0]).toBeInstanceOf(FormData);
+        expect(typeof mockRegister.mock.calls[0][1].onUploadProgress).toBe("function");
+
+        await act(async () => { finish(); });
+        await waitFor(() => expect(screen.queryByRole("progressbar")).toBeNull());
+        expect(screen.getByText("auth.verify.accountCreated")).toBeInTheDocument();
+    });
+
+    it("removes the progress bar and shows the error when the upload fails", async () => {
+        mockRegister.mockImplementation(async (_payload, options) => {
+            options.onUploadProgress({ loaded: 10, total: 100 });
+            return { success: false, message: "Upload failed" };
+        });
+
+        const user = userEvent.setup();
+        const { container } = render(<MemoryRouter><Register /></MemoryRouter>);
+        await fillAccountAndContinue(user);
+        await attachDocuments(user, container);
+        submitDocuments(container);
+
+        expect(await screen.findByText("Upload failed")).toBeInTheDocument();
+        expect(screen.queryByRole("progressbar")).toBeNull();
+    });
+});
